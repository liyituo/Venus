[Unit]
Description=PC Agent Telegram Bot
After=network.target pc-agent-llm.service
Wants=pc-agent-llm.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=PYTHONUTF8=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=HTTP_PROXY=http://127.0.0.1:7897
Environment=HTTPS_PROXY=http://127.0.0.1:7897
Environment=NO_PROXY=localhost,127.0.0.1
ExecStart=%h/.venv/bin/python -u %h/src/telegram_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
